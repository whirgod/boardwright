{
  "name": "boardwright",
  "private": true,
  "type": "module",
  "description": "Game master host for rule-based board game engines.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "games/*",
    "engines/*"
  ],
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev:server": "npm run dev --workspace @boardwright/server",
    "start:server": "npm run start --workspace @boardwright/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
