{
  "workspace": [
    "./packages/*",
    "./apps/*",
    "./games/*",
    "./engines/*"
  ],
  "unstable": ["worker-options"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "proseWrap": "preserve"
  },
  "exclude": [
    ".agents/",
    ".claude/worktrees/",
    "apps/web/dist/"
  ],
  "coverage": {
    "thresholds": {
      "lines": 85,
      "branches": 75,
      "functions": 85
    }
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno task test",
    "dev": {
      "description": "Rebuild the web UI on change and run the server in watch mode",
      "dependencies": ["dev:web", "dev:server"]
    },
    "dev:server": "deno task --cwd apps/server dev",
    "dev:web": "deno task --cwd apps/web watch",
    "build:web": "deno task --cwd apps/web build",
    "start": {
      "description": "Build the web UI, then run the server",
      "command": "deno task --cwd apps/server start",
      "dependencies": ["build:web"]
    },
    "start:server": "deno task --cwd apps/server start",
    "test": "deno test --allow-read=apps,engines,games,packages,.test-tmp --allow-write=.test-tmp --allow-net=127.0.0.1 --coverage --clean && deno coverage --exclude='/main\\.ts$'"
  }
}
